{
  "name": "gammerce/sklep-sms",
  "description": "Shop SMS makes it easier to earn money on your game servers.",
  "type": "project",
  "license": "GPL-3.0",
  "authors": [
    {
      "name": "Michał Budziak",
      "email": "michal.mariusz.b@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "vlucas/phpdotenv": "^5.6",
    "illuminate/container": "^11.0",
    "symfony/console": "^6.4|^7.4",
    "symfony/expression-language": "^6.4|^7.4",
    "symfony/http-foundation": "^6.4|^7.4",
    "sentry/sdk": "^4.0",
    "psr/simple-cache": "^3.0",
    "nikic/fast-route": "^1.3",
    "myclabs/php-enum": "^1.8",
    "phpmailer/phpmailer": "^6.9|^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5|^11.5|^12.0",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.23",
    "symfony/var-dumper": "^6.4|^7.4",
    "psy/psysh": "^0.12"
  },
  "autoload": {
    "files": [
      "includes/functions.php"
    ],
    "psr-4": {
      "App\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2"
    }
  }
}
